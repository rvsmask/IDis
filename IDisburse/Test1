 private Tuple<DataTable, DataTable> SplitCSVIntoTables(string content)
 {
     var lines = content.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);
     List<string> section1 = new List<string>();
     List<string> section2 = new List<string>();

     bool foundSecond = false;
     foreach (var line in lines)
     {
         if (!foundSecond && string.IsNullOrWhiteSpace(line)) // assuming empty line separates sections
         {
             foundSecond = true;
             continue;
         }

         if (!foundSecond)
             section1.Add(line);
         else
             section2.Add(line);
     }

     return Tuple.Create(ParseCSV(section1), ParseCSV(section2));
 }

 private DataTable ParseCSV(List<string> lines)
 {
     DataTable dt = new DataTable();
     if (lines.Count == 0) return dt;

     string[] headers = lines[0].Split(',');
     foreach (string header in headers)
         dt.Columns.Add(header.Trim());

     for (int i = 1; i < lines.Count; i++)
     {
         if (string.IsNullOrWhiteSpace(lines[i])) continue;
         string[] fields = lines[i].Split(',');
         dt.Rows.Add(fields);
     }

     return dt;
 }
